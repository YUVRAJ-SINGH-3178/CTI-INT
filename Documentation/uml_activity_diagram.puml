@startuml
skinparam roundcorner 10
skinparam shadowing true

start

:Operator Launches Java AWT Console;
:Display AwtLoginFrame;
:Enter Credentials (username, password);

if (Verify Salted SHA-256 Hash?) then (Valid)
    :Grant Role Access (ADMIN / ANALYST / OPERATOR);
    :Initialize AwtDashboardFrame (CardLayout);
else (Invalid)
    :Display Authentication Error Label;
    stop
endif

fork
    :User Starts Async CICIoV2024 / VeReMi Stream;
    :Dispatch Task to ExecutorService Thread Pool;
    :Parse CICIoV2024 CSV / VeReMi .tgz Packets;
    :Execute SQLite Batch Transaction (setAutoCommit false);
    :Post Progress to EDT via EventQueue.invokeLater();
fork again
    :Monitor 7,683 Real Alerts;
    :Filter via Java Streams (Keyword, Domain, ATT&CK, Severity);
    :Sort Descending by Heuristic Risk Score;
end fork

:Operator Selects Alert Row;
:Lookup ATT&CK Technique in attack-stix-data (STIX 2.1);
:Display CWE Weakness, Target ECU Assets & Risk Formula;

if (Operator Action?) then (Edit Alert)
    :Open AwtAlertFormDialog;
    :Validate Inputs & Save PreparedStatement UPDATE;
else if (Delete Alert)
    :Show Confirmation AWT Dialog;
    if (Confirmed?) then (Yes)
        :Execute PreparedStatement DELETE;
    else (No)
        :Cancel Deletion;
    endif
else if (Export CSV)
    :Open AWT FileDialog (SAVE);
    :Write CSV File & Insert audit_reports Entry;
endif

:Refresh Alert Inventory & Details;

stop
@enduml
