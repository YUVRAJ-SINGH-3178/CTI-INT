@startuml
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam shadowing true

actor "Security Analyst" as Analyst
actor "SOC Administrator" as Admin
actor "Vehicle Telemetry Sources\n(CICIoV2024 & VeReMi)" as Telemetry

rectangle "Connected Vehicle CTI Operations Console (Java AWT)" {
    usecase "Authenticate & Login (Salted SHA-256)" as UC_Login
    usecase "View 7,683 Ranked Alerts" as UC_ViewAlerts
    usecase "Filter Alerts (Keyword, Domain, ATT&CK, Severity)" as UC_Filter
    usecase "Inspect STIX 2.1 & Heuristic Risk Breakdown" as UC_Detail
    usecase "Create / Update Intrusion Alert" as UC_AlertCRUD
    usecase "Delete Alert (Confirmation Required)" as UC_DeleteAlert
    usecase "Explore Threat Graph (28 Nodes, 46 Edges)" as UC_Graph
    usecase "Async Ingest CICIoV2024 CSVs & VeReMi .tgz" as UC_Telemetry
    usecase "Recalculate Heuristic Risk Scores" as UC_RecalcRisk
    usecase "Export Visible Alerts CSV & Audit Trail" as UC_ExportCSV
    usecase "Inspect 20-Seed & Full Benchmarks (Real CSVs)" as UC_Benchmarks
    usecase "Audit MITRE attack-stix-data Catalog" as UC_Stix
}

Analyst --> UC_Login
Analyst --> UC_ViewAlerts
Analyst --> UC_Filter
Analyst --> UC_Detail
Analyst --> UC_AlertCRUD
Analyst --> UC_DeleteAlert
Analyst --> UC_Graph
Analyst --> UC_Telemetry
Analyst --> UC_ExportCSV
Analyst --> UC_Benchmarks
Analyst --> UC_Stix

Admin --|> Analyst
Telemetry --> UC_Telemetry

UC_AlertCRUD ..> UC_RecalcRisk : <<includes>>
UC_DeleteAlert ..> UC_ViewAlerts : <<updates>>

@enduml
